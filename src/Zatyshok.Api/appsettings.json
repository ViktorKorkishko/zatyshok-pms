{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    },
    // JSON records with scopes, so that every record of a request carries its CorrelationId
    // (table 9.9 of report 2: ILogger with the JSON format and CorrelationId).
    "Console": {
      "FormatterName": "json",
      "FormatterOptions": {
        "IncludeScopes": true,
        "UseUtcTimestamp": true,
        "TimestampFormat": "yyyy-MM-ddTHH:mm:ss.fffZ "
      }
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    // No password here on purpose: set DB_PASSWORD via user-secrets or an
    // environment variable (see README, "Запуск з нуля").
    "Default": "Host=localhost;Port=5432;Database=zatyshok;Username=zatyshok"
  }
}
